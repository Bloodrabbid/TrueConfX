{
  "name": "trueconfx",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5199 --strictPort\" \"wait-on tcp:5199 && cross-env VITE_DEV_SERVER_URL=http://localhost:5199 electron .\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:web": "vite",
    "typecheck": "tsc -b --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.61.0",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1",
    "zustand": "^5.0.16"
  },
  "productName": "TrueConfX",
  "main": "electron/main.cjs",
  "build": {
    "appId": "ru.local.trueconfx",
    "productName": "TrueConfX",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "protocols": [
      {
        "name": "TrueConfX",
        "schemes": [
          "trueconfx"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "identity": null,
      "extendInfo": {
        "NSCameraUsageDescription": "Камера для видеоконференций",
        "NSMicrophoneUsageDescription": "Микрофон для видеоконференций",
        "NSScreenCaptureUsageDescription": "Демонстрация экрана в конференции"
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "maintainer": "Bloodrabbid <Bloodrabbid@users.noreply.github.com>"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "publish": null,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "description": "Неофициальный современный кроссплатформенный клиент для TrueConf Server",
  "author": {
    "name": "Bloodrabbid",
    "email": "Bloodrabbid@users.noreply.github.com"
  },
  "homepage": "https://github.com/Bloodrabbid/TrueConfX",
  "license": "UNLICENSED"
}
