{
  "name": "trueconfx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --port 5199 --strictPort\" \"wait-on tcp:5199 && cross-env VITE_DEV_SERVER_URL=http://localhost:5199 electron .\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:web": "vite",
    "typecheck": "tsc -b --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "productName": "TrueConfX",
  "main": "electron/main.cjs",
  "build": {
    "appId": "ru.local.trueconfx",
    "productName": "TrueConfX",
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png"
    ],
    "protocols": [
      {
        "name": "TrueConfX",
        "schemes": [
          "trueconfx"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "extendInfo": {
        "NSCameraUsageDescription": "Камера для видеоконференций",
        "NSMicrophoneUsageDescription": "Микрофон для видеоконференций"
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network"
    },
    "directories": {
      "buildResources": "build",
      "output": "release"
    }
  }
}